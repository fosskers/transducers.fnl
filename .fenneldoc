{:modules-info
 {"transducers.fnl"
  {:name "Transducers"
   :version "1.0.0"
   :description "Ergonomic, efficient data processing."
   :license "GPLv3"
   :doc-order [{:title "Entry"
                :description "High-level entrypoints."
                :items [:transduce]}
               {:title "Transducers"
                :description "Various 'mapping' functions."
                :items [:pass :map
                        :filter :filter-map
                        :drop :drop-while
                        :take :take-while
                        :enumerate
                        :intersperse
                        :concat
                        :segment :window
                        :group-by
                        :unique :unique-by :dedup
                        :step :scan
                        :once]}
               {:title "Reducers"
                :description "Reduction 'targets'. Also known as 'folds'."
                :items [:cons :keyed
                        :count :quantities
                        :add :mul :average
                        :all? :any? :all :any
                        :first :last
                        :csv-write
                        :fold
                        :for-each]}
               {:title "Sources"
                :description "Sources of data to iterate over."
                :items [:iter :file :repeat :cycle :ints :csv-read]}
               {:title "Utilities"
                :items [:comp
                        :reduced :reduced? :unreduce]}]}}}

